config BR2_PACKAGE_GFXSTREAM
	bool "gfxstream"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_TOOLCHAIN_USES_GLIBC # required by prebuilt/upstream assumptions
	depends on !BR2_STATIC_LIBS # dlopen / shared libraries
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_LIBAEMU
	select BR2_PACKAGE_VULKAN_HEADERS
	select BR2_PACKAGE_VULKAN_LOADER
	help
	  Graphics Streaming Kit (gfxstream) for forwarding OpenGL ES
	  and Vulkan calls from a virtual machine guest to a host.

	  https://googlesource.com

comment "gfxstream needs a glibc toolchain w/ C++, threads, dynamic library"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS || \
		!BR2_TOOLCHAIN_USES_GLIBC || BR2_STATIC_LIBS

