config BR2_PACKAGE_LIBAEMU
	bool "libaemu"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_TOOLCHAIN_USES_GLIBC
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_LZ4
	help
	  Android Emulator (AEMU) common utility libraries, including
	  aemu-base, aemu-host-common, and aemu-logging required by
	  gfxstream.

	  https://googlesource.com

comment "libaemu needs a glibc toolchain w/ C++, threads, dynamic library"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS || \
		!BR2_TOOLCHAIN_USES_GLIBC || BR2_STATIC_LIBS

